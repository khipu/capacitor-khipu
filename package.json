{
  "name": "capacitor-khipu",
  "version": "2.11.1",
  "description": "Capacitor plugin for Khipu",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "CapacitorKhipu.podspec"
  ],
  "author": "Khipu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khipu/capacitor-khipu.git"
  },
  "bugs": {
    "url": "https://github.com/khipu/capacitor-khipu/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "scripts": {
    "verify": "npm run test && npm run verify:versions && npm run verify:keys && npm run verify:ios && npm run verify:android && npm run verify:web",
    "test": "vitest run",
    "verify:versions": "node scripts/check-native-versions.mjs",
    "verify:keys": "node scripts/check-option-keys.mjs",
    "verify:ios": "xcodebuild build -scheme CapacitorKhipu -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts,mjs --max-warnings 0",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api KhipuPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "release": "release-it"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^7.6.9",
    "@commitlint/config-conventional": "^19.2.2",
    "@evilmartians/lefthook": "^1.6.14",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@release-it/conventional-changelog": "^8.0.1",
    "commitlint": "^19.3.0",
    "eslint": "^8.57.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-java": "^2.10.3",
    "release-it": "^17.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@capacitor/core": ">=7.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "root": true,
    "extends": "@ionic/eslint-config/recommended",
    "overrides": [
      {
        "files": [
          "**/*.js"
        ],
        "rules": {
          "@typescript-eslint/explicit-module-boundary-types": "off"
        },
        "env": {
          "browser": true
        }
      },
      {
        "files": ["scripts/**", "*.mjs"],
        "env": {
          "node": true
        }
      }
    ]
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  }
}
